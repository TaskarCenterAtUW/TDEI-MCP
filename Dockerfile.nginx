# Small nginx gateway: path-based reverse proxy in front of `npm run start:multi` children.
# Build: docker build -f Dockerfile.nginx -t tdei-mcp-gateway .
# Run (nginx fronts host-side children on 3000..3003):
#   docker run --rm -p 8080:80 --add-host=host.docker.internal:host-gateway tdei-mcp-gateway
# Generate from your mcps.json (requires npm run build first):
#   npm run nginx:generate -- --file mcps.json
FROM nginx:1.27-alpine
COPY nginx/nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/gateway.html /usr/share/nginx/html/gateway.html
EXPOSE 80
