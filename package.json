{
  "name": "tdei-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "TDEI-MCP connector for the TDEI API",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaskarCenterAtUW/TDEI-MCP.git"
  },
  "bin": {
    "tdei-mcp": "dist/index.js",
    "tdei-mcp-init": "dist/init.js",
    "tdei-mcp-multi": "dist/multi-serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    }
  },
  "files": [
    "dist",
    "docs/openapi-mcp-core.md",
    "README.md",
    ".env.example",
    "tdei.config.schema.json",
    "tdei.config.example.json",
    "mcps.schema.json",
    "mcps.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:multi": "tsx src/multi-serve.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "start:multi": "node dist/multi-serve.js",
    "acceptance_tests": "pnpm --dir tests/acceptance run acceptance_tests --",
    "deploy:node": "bash scripts/deploy-node.sh",
    "deploy:docker": "bash scripts/deploy-docker.sh up",
    "deploy:docker:down": "bash scripts/deploy-docker.sh down",
    "prepublishOnly": "pnpm build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:live": "node --env-file=.env --import tsx scripts/live-session-smoke.ts",
    "test:live-parse": "node --import tsx scripts/live-response-parse-probe.ts",
    "check:stdio": "node --env-file=.env --import tsx scripts/stdio-check.ts",
    "test:smoke": "node --import tsx scripts/smoke-test.ts",
    "lint": "tsc --noEmit && oxlint src test scripts && prettier --check src test scripts",
    "knip": "knip",
    "prepare": "husky || true",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=85 --test-coverage-branches=70 --test-coverage-functions=72 test/**/*.test.ts",
    "audit": "pnpm audit --audit-level=moderate",
    "secret-scan": "bash scripts/secret-scan.sh",
    "test:mutation": "stryker run"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.1.1",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
