{
  "name": "tdei-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "TDEI-MCP connector for the TDEI API",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaskarCenterAtUW/TDEI-MCP.git"
  },
  "bin": {
    "tdei-mcp": "dist/index.js",
    "tdei-mcp-init": "dist/init.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "tdei.config.schema.json",
    "tdei.config.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:live": "node --env-file=.env --import tsx scripts/live-session-smoke.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0"
  }
}
