{
  "name": "tdei-mcp",
  "version": "0.1.0",
  "type": "module",
  "description": "TDEI-MCP connector for the TDEI API",
  "repository": {
    "type": "git",
    "url": "https://github.com/TaskarCenterAtUW/TDEI-MCP.git"
  },
  "bin": {
    "tdei-mcp": "dist/index.js",
    "tdei-mcp-init": "dist/init.js",
    "tdei-mcp-multi": "dist/multi-serve.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./openapi": {
      "types": "./dist/openapi/index.d.ts",
      "import": "./dist/openapi/index.js"
    }
  },
  "files": [
    "dist",
    "docs/openapi-mcp-core.md",
    "README.md",
    ".env.example",
    "tdei.config.schema.json",
    "tdei.config.example.json",
    "mcps.schema.json",
    "mcps.example.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:multi": "tsx src/multi-serve.ts",
    "build": "node scripts/clean-dist.mjs && tsc",
    "start": "node dist/index.js",
    "start:multi": "node dist/multi-serve.js",
    "nginx:generate": "node scripts/generate-nginx-conf.mjs",
    "gateway:generate": "node scripts/generate-nginx-conf.mjs --file mcps.json --out nginx/nginx.conf --upstream-host multi",
    "gateway:up": "npm run gateway:generate && docker compose up -d --build",
    "gateway:down": "docker compose down",
    "prepublishOnly": "npm run build",
    "test": "node --import tsx --test test/**/*.test.ts",
    "test:live": "node --env-file=.env --import tsx scripts/live-session-smoke.ts",
    "test:live-parse": "node --import tsx scripts/live-response-parse-probe.ts",
    "check:stdio": "node --env-file=.env --import tsx scripts/stdio-check.ts",
    "test:smoke": "node --import tsx scripts/smoke-test.ts",
    "lint": "tsc --noEmit",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
