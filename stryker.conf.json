{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "command",
  "commandRunner": {
    "command": "node --import tsx --test test/intent-resolver.test.ts test/semantic-intent-module.test.ts"
  },
  "mutate": ["src/intents/intent-resolver.ts", "src/intents/semantic-intent-module.ts"],
  "reporters": ["clear-text", "progress"],
  "thresholds": { "high": 80, "low": 60, "break": null },
  "concurrency": 4,
  "timeoutMS": 120000,
  "cleanTempDir": true,
  "inPlace": true
}
