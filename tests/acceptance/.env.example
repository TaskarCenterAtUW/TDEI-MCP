# TDEI-MCP acceptance suite configuration.
#
# Setup:  cp tests/acceptance/.env.example tests/acceptance/.env   then fill in values.
# The copy (tests/acceptance/.env) is git-ignored. Never commit real values.
# Every setting is optional unless marked REQUIRED. Values shown are the recommended defaults.

# ---------------------------------------------------------------------------
# Target servers (REQUIRED)
# ---------------------------------------------------------------------------
# MCP server address: scheme + host (+ port), no trailing slash, no slug. Example: Azure Container App host or http://127.0.0.1:3000
ACCEPT_GATEWAY_BASE_URL=https://REPLACE-WITH-CONTAINER-APP-HOST
# Comma-separated list of servers to test, each as  slug  or  slug:environment-label
#   slug              = server name from mcps.json; its MCP URL is <ACCEPT_GATEWAY_BASE_URL>/<slug>/mcp
#   environment-label = which TDEI environment the slug talks to (dev, staging, production, ...).
#                       Slugs with the same label share one login and are not cross-checked.
#                       Defaults to the slug itself when omitted.
# The WHOLE suite runs separately for every entry, one after another, with its own report folder.
# Example: ACCEPT_SLUGS=tdei-core-dev:dev,tdei-core-staging:staging,tdei-core-production:production
ACCEPT_SLUGS=tdei-core-dev:dev
# Slugs that also run Part 2 (LLM scenarios). Blank = every slug in ACCEPT_SLUGS except those whose
# environment label is "prod" or "production", because tool results (project group and dataset
# metadata) are sent to the LLM provider. List a production slug here to include it.
ACCEPT_PART2_SLUGS=
# Optional: the git SHA you expect the server to report as its build (health and initialize).
# CI sets this to the commit it just deployed. Blank = not checked.
ACCEPT_EXPECTED_BUILD_SHA=

# ---------------------------------------------------------------------------
# Authentication (interactive login once, then persisted and refreshed)
# ---------------------------------------------------------------------------
# Token store root. Files are written with mode 0600. Must be outside the repository.
# Tokens are stored per environment label under ~/.tdei-mcp-tests/<label>/default.json
# A login is required once per distinct label. All logins are requested at the start of a run.
# Fixed by the Keycloak client registration. Change only if TDEI registers another loopback port.
# auto = prompt for login when a terminal is attached, otherwise exit 3
# never = always exit 3 when login is needed (unattended runs)
ACCEPT_INTERACTIVE=auto
ACCEPT_LOGIN_TIMEOUT_SEC=300
# Refresh the access token when fewer than this many seconds remain.
ACCEPT_REFRESH_SKEW_SEC=120

# ---------------------------------------------------------------------------
# Test data (all optional)
# ---------------------------------------------------------------------------
# Place used by dataset-search tests and scenarios.
# Any of the three settings below can be overridden for one slug by prefixing the slug in
# upper case with dashes turned into underscores, for example
#   ACCEPT_TDEI_CORE_STAGING_TEST_PLACE=Portland
#   ACCEPT_TDEI_CORE_STAGING_FIXTURE_DATASET_ID=<id>
ACCEPT_TEST_PLACE=Seattle
# Known published dataset id. Blank = discovered at run time from tdei_find_datasets.
ACCEPT_FIXTURE_DATASET_ID=
# A project group id the test user is NOT a member of. Blank = skip that forbidden-access case.
ACCEPT_FOREIGN_PROJECT_GROUP_ID=

# ---------------------------------------------------------------------------
# Tool set expectations
# ---------------------------------------------------------------------------
# JSON snapshot of the expected tools/list (names + input schemas), created with `acceptance snapshot`.
# {slug} is replaced with each slug, so every server has its own snapshot.
ACCEPT_EXPECTED_TOOLS_FILE=fixtures/expected-tools.{slug}.json
# true  = a tool missing from tools/list fails the run (use for the post-deploy gate)
# false = tests for a missing tool are reported as skipped (use while a release is partly deployed)
ACCEPT_STRICT_TOOLSET=true

# ---------------------------------------------------------------------------
# HTTP and latency
# ---------------------------------------------------------------------------
# Client-side timeout per request. Must exceed the server's worst case: it allows 15 s per
# upstream TDEI call and dataset search can chain three calls plus the geocoder.
ACCEPT_HTTP_TIMEOUT_MS=60000
# record = log latency only (use for the first two weeks to calibrate)
# enforce = fail when p95 exceeds the budget
ACCEPT_LATENCY_MODE=record
ACCEPT_LATENCY_WARMUP=2
ACCEPT_LATENCY_SAMPLES=20
# p95 budgets in milliseconds.
ACCEPT_BUDGET_HEALTH_MS=1000
ACCEPT_BUDGET_INITIALIZE_MS=3000
ACCEPT_BUDGET_TOOLS_LIST_MS=2000
ACCEPT_BUDGET_RESOLVE_INTENT_MS=1500
# project groups, services, dataset details, identity
ACCEPT_BUDGET_READ_TOOL_MS=5000
ACCEPT_BUDGET_FIND_DATASETS_MS=8000
# find_datasets when the name and city searches miss and the geocoder runs
ACCEPT_BUDGET_FIND_DATASETS_GEOCODE_MS=12000
# list_jobs fans out across project groups
ACCEPT_BUDGET_LIST_JOBS_MS=10000
ACCEPT_BUDGET_INSTALLER_MS=2000
# Wall-clock ceiling for one Part 2 scenario, all turns included.
ACCEPT_BUDGET_SCENARIO_MS=120000

# ---------------------------------------------------------------------------
# Part 2: LLM (user-interaction tests)
# ---------------------------------------------------------------------------
# anthropic | openai | gemini
ACCEPT_LLM_PROVIDER=anthropic
# Model for nightly runs (a small, fast model). Set to the model id you use.
ACCEPT_LLM_MODEL=
# Model for release-gating runs. Blank = same as ACCEPT_LLM_MODEL.
ACCEPT_LLM_MODEL_GATE=
# Only the key for the selected provider is read.
ANTHROPIC_API_KEY=
# Base URL for any OpenAI-compatible endpoint (used when ACCEPT_LLM_PROVIDER=openai): OpenAI, Azure OpenAI /openai/v1, OpenRouter, Ollama, vLLM, LiteLLM...
# Blank = https://api.openai.com/v1. The key may be blank for local servers that need none.
ACCEPT_LLM_BASE_URL=
OPENAI_API_KEY=
GEMINI_API_KEY=
ACCEPT_LLM_TEMPERATURE=0
# Times each scenario is run (pass thresholds are in the spec, section 6.6).
ACCEPT_LLM_REPEATS=3
ACCEPT_LLM_MAX_TURNS=8
ACCEPT_LLM_MAX_TOOL_TURNS=6
# Hard token ceilings. The run stops and fails when exceeded.
ACCEPT_LLM_MAX_TOKENS_PER_SCENARIO=80000
ACCEPT_LLM_MAX_TOKENS_PER_RUN=1500000
# replay = use recorded LLM responses where the tools/list fingerprint matches (cheap, for PR builds)
# live   = always call the provider
# record = call the provider and refresh the recordings
ACCEPT_LLM_MODE=live

# ---------------------------------------------------------------------------
# Target B: isolated container for fault-injection tests (T5, T7, T16, U4, U11-U13)
# ---------------------------------------------------------------------------
ACCEPT_B_ENABLED=false
# Image under test, for example registry/repo:dev-latest or a local tag.
ACCEPT_B_IMAGE=
ACCEPT_B_PORT=3300

# ---------------------------------------------------------------------------
# Reports
# ---------------------------------------------------------------------------
ACCEPT_REPORT_DIR=reports
