TDEI_API_URL=https://api-dev.tdei.us
TDEI_SPEC_URL=https://raw.githubusercontent.com/TaskarCenterAtUW/TDEI-ExternalAPIs/dev/tdei-api-gateway.json
# SSO client_id is fixed to tdei-mcp in code (not configurable).
TDEI_SSO_CALLBACK_URL=http://127.0.0.1:8765/callback
# Optional override. Keep this pinned to a version tested with this connector.
TDEI_AWS_MCP_PACKAGE=awslabs.openapi-mcp-server@1.1.2
# Optional Nominatim-compatible forward geocoder. Required for place-to-bbox
# fallback after dataset name and city searches return no results.
# TDEI_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Use an identifying value that follows the geocoder provider's policy.
# TDEI_GEOCODER_USER_AGENT=tdei-mcp/0.1 (mailto:operator@example.com)
TDEI_TRANSPORT=stdio
TDEI_HTTP_HOST=127.0.0.1
TDEI_HTTP_PORT=3000
TDEI_HTTP_BASE_PATH=/mcp
# Comma-separated allowed origins; empty = same-origin only.
TDEI_CORS_ORIGINS=
# Absent = plain HTTP (use reverse-proxy TLS termination for public https).
# TDEI_TLS_CERT=/path/to/cert.pem
# TDEI_TLS_KEY=/path/to/key.pem
# In HTTP mode the callback may be a registered https URL:
# TDEI_SSO_CALLBACK_URL=https://mcp.example.com/callback
