# Required. OpenAPI spec is derived from this host:
#   api-dev.tdei.us   → TDEI-ExternalAPIs/dev
#   api-stage.tdei.us → TDEI-ExternalAPIs/stage
#   api.tdei.us       → TDEI-ExternalAPIs/main
TDEI_API_URL=https://api-dev.tdei.us

# Optional overrides (omit to use defaults).
# TDEI_SPEC_URL=https://raw.githubusercontent.com/TaskarCenterAtUW/TDEI-ExternalAPIs/dev/tdei-api-gateway.json
# SSO client_id is always tdei-mcp in code (not an env var).
# Callback defaults to http://127.0.0.1:8765/callback — set only for another registered port or HTTPS HTTP-mode callback.
# TDEI_SSO_CALLBACK_URL=http://127.0.0.1:8765/callback
# Stdio OpenAPI child only; HTTP mode does not launch this package.
# TDEI_AWS_MCP_PACKAGE=awslabs.openapi-mcp-server@1.1.2
# TDEI_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# TDEI_GEOCODER_USER_AGENT=tdei-mcp/0.1 (mailto:operator@example.com)
# TDEI_TRANSPORT=stdio
# TDEI_HTTP_HOST=127.0.0.1
# TDEI_HTTP_PORT=3000
# TDEI_HTTP_BASE_PATH=/mcp
# TDEI_CORS_ORIGINS=
# TDEI_TLS_CERT=/path/to/cert.pem
# TDEI_TLS_KEY=/path/to/key.pem
