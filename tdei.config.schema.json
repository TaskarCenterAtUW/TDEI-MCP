{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tdei.config.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "endpoints": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["all", "allow", "deny"], "default": "all" },
        "allow": { "type": "array", "items": { "type": "string" }, "default": [] },
        "deny": { "type": "array", "items": { "type": "string" }, "default": [] }
      },
      "additionalProperties": false
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "steps"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "description": { "type": "string" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "tool"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "tool": { "type": "string" },
                "ask": { "type": "array", "items": { "type": "string" }, "default": [] },
                "input": { "type": "object", "default": {} }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
