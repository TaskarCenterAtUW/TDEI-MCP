{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mcps.json",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "host": { "type": "string", "default": "127.0.0.1" },
    "basePort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 3000 },
    "basePath": { "type": "string", "description": "Shared prefix. Supports {name}, e.g. \"/mcp/{name}\". Omit for per-server /<slug>/mcp." },
    "ssoCallbackPort": { "type": "integer", "minimum": 1, "maximum": 65535, "default": 8765 },
    "servers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["name", "apiUrl"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "apiUrl": { "type": "string" },
          "specUrl": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "basePath": { "type": "string" },
          "ssoCallbackUrl": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "required": ["servers"],
  "additionalProperties": false
}
